[submodule "src/Vulkan-Hpp"]
	path = src/Vulkan-Hpp
	url = https://github.com/KhronosGroup/Vulkan-Hpp.git
	shallow = true
[submodule "src/glm"]
	path = src/glm
	url = https://github.com/g-truc/glm.git
	shallow = true
[submodule "src/googletest"]
	path = src/googletest
	url = https://github.com/google/googletest.git
	shallow = true
	update = none
[submodule "src/stb"]
	path = src/stb
	url = https://github.com/nothings/stb.git
	shallow = true
[submodule "src/qtadvanceddocking"]
	path = src/qtadvanceddocking
	url = https://github.com/githubuser0xFFFF/Qt-Advanced-Docking-System.git
	shallow = true
[submodule "src/cereal"]
	path = src/cereal
	url = https://github.com/USCiLab/cereal.git
	shallow = true
[submodule "src/shaderc"]
	path = src/shaderc
	url = https://github.com/google/shaderc
	shallow = true
[submodule "src/asio"]
	path = src/asio
	url = https://github.com/chriskohlhoff/asio.git
	shallow = true
[submodule "src/cli11"]
	path = src/cli11
	url = https://github.com/CLIUtils/CLI11.git
	shallow = true
[submodule "src/json"]
	path = src/json
	url = https://github.com/nlohmann/json.git
	shallow = true
